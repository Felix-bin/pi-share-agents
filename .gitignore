.pi/todos/
.pi/subagents/
.pi-subagents/
.DS_Store
node_modules/
# The pi-coding-agent test shim carries hand-written peer-package stubs under its
# own node_modules. They are fixtures, not installed packages: without them a
# clean checkout cannot resolve the host peer aliases the detached runner needs.
!test/fixtures/pi-coding-agent-shim/node_modules/
.fallow/
tmp/

# Local-only checkout of the upstream SYNAPSE Python prototype. It is a reference
# implementation we read, not code we ship: the upstream tree carries ~84MB of
# competition media (PPT, demo video) that would live in this repo's history
# forever and slow down every `pi install git:` clone.
# See docs/synapse-python-prototype.md for how to create it.
/reference/

# Collector build output. vmlinux.h is generated from the running kernel's BTF
# and the skeleton from the compiled object, so both are machine-specific:
# committing them would pin the build to whichever kernel produced them.
/native/synapse-io-collector/build/

# Fallback ignores for local ad-hoc agent and lane reports.
/memory.md
/todo.md
/reports/
/*-report*.json
/issue-*-council-*.json
/council-*.md
/oracle-council-*.md
/perf-*.md
/pr-*-gate*.json
/pr-*-review*.md
